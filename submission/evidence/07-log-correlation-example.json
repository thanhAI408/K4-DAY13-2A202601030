        "feature": "monitoring"
      },
      {
        "event": "retrieval_completed",
        "service": "retrieval",
        "latency_ms": 150,
        "payload": {"doc_count": 3}
      },
      {
        "event": "response_sent",
        "service": "api",
        "latency_ms": 850,
        "tokens_in": 1200,
        "tokens_out": 150,
        "cost_usd": 0.0045
      }
